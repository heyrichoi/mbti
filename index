<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>성격의 결</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#EEF1F5;
    --paper:#FFFFFF;
    --ink:#1B1A2E;
    --ink-soft:#5B5972;
    --accent:#7B4B94;
    --accent2:#C48A2E;
    --line:#DADCE4;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:'Noto Sans KR', sans-serif;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:32px 16px;
    line-height:1.6;
  }
  .stage{
    width:100%;
    max-width:560px;
  }
  .card{
    background:var(--paper);
    border-radius:2px;
    padding:48px 40px;
    border:1px solid var(--line);
    position:relative;
  }
  @media (max-width:480px){
    .card{padding:32px 22px;}
  }
  h1,h2{
    font-family:'Gowun Batang', serif;
    font-weight:700;
    margin:0;
  }
  /* ---------- INTRO ---------- */
  #screen-intro .kicker{
    color:var(--accent);
    font-size:14px;
    letter-spacing:0.02em;
    margin-bottom:10px;
  }
  #screen-intro h1{
    font-size:32px;
    line-height:1.35;
    margin-bottom:18px;
  }
  #screen-intro p.desc{
    color:var(--ink-soft);
    font-size:15px;
    max-width:42ch;
    margin-bottom:32px;
  }
  .field label{
    display:block;
    font-size:13px;
    color:var(--ink-soft);
    margin-bottom:8px;
  }
  input[type="text"]{
    width:100%;
    font-family:'Noto Sans KR', sans-serif;
    font-size:17px;
    padding:12px 4px;
    border:none;
    border-bottom:2px solid var(--line);
    background:transparent;
    color:var(--ink);
    outline:none;
    transition:border-color .2s ease;
  }
  input[type="text"]:focus{
    border-bottom-color:var(--accent);
  }
  .btn{
    font-family:'Noto Sans KR', sans-serif;
    font-size:15px;
    font-weight:500;
    border:none;
    cursor:pointer;
    padding:13px 26px;
    background:var(--ink);
    color:#fff;
    border-radius:2px;
    transition:transform .15s ease, background .2s ease;
  }
  .btn:hover{background:var(--accent);}
  .btn:active{transform:scale(0.98);}
  .btn:disabled{opacity:.35; cursor:not-allowed;}
  #screen-intro .start-row{
    margin-top:28px;
    display:flex;
    justify-content:flex-end;
  }
  /* ---------- QUIZ ---------- */
  #screen-quiz{display:none;}
  .progress-track{
    height:2px;
    background:var(--line);
    width:100%;
    margin-bottom:36px;
    position:relative;
  }
  .progress-fill{
    height:2px;
    background:var(--accent);
    width:0%;
    transition:width .35s ease;
  }
  .progress-label{
    font-size:12px;
    color:var(--ink-soft);
    margin-bottom:26px;
  }
  .question-text{
    font-family:'Gowun Batang', serif;
    font-size:24px;
    line-height:1.55;
    margin-bottom:40px;
    min-height:110px;
  }
  .scale{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:6px;
  }
  .scale-option{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:10px;
    cursor:pointer;
    flex:1;
    background:none;
    border:none;
    padding:6px 0;
  }
  .dot{
    border-radius:50%;
    background:var(--paper);
    border:2px solid var(--ink-soft);
    transition:all .15s ease;
  }
  .scale-option[data-v="1"] .dot, .scale-option[data-v="5"] .dot{width:30px;height:30px;}
  .scale-option[data-v="2"] .dot, .scale-option[data-v="4"] .dot{width:23px;height:23px;}
  .scale-option[data-v="3"] .dot{width:16px;height:16px;}
  .scale-option:hover .dot{border-color:var(--accent);}
  .scale-option.selected .dot{
    background:var(--accent);
    border-color:var(--accent);
  }
  .scale-caption{
    font-size:11px;
    color:var(--ink-soft);
    text-align:center;
    max-width:60px;
  }
  .scale-option:first-child .scale-caption,
  .scale-option:last-child .scale-caption{
    color:var(--ink);
  }
  .nav-row{
    display:flex;
    justify-content:space-between;
    margin-top:44px;
  }
  .link-btn{
    background:none;
    border:none;
    color:var(--ink-soft);
    font-size:14px;
    cursor:pointer;
    padding:8px 0;
  }
  .link-btn:hover{color:var(--ink);}
  .link-btn:disabled{opacity:0; cursor:default;}
  /* ---------- RESULT ---------- */
  #screen-result{display:none;}
  #screen-result .kicker{
    font-size:14px;
    color:var(--ink-soft);
    margin-bottom:6px;
  }
  .type-letters{
    font-family:'Gowun Batang', serif;
    font-size:64px;
    font-weight:700;
    color:var(--accent);
    letter-spacing:0.04em;
    margin:6px 0 4px;
  }
  .type-name{
    font-family:'Gowun Batang', serif;
    font-size:22px;
    margin-bottom:22px;
  }
  .type-desc{
    color:var(--ink-soft);
    font-size:15px;
    margin-bottom:36px;
  }
  .axis-row{
    display:flex;
    flex-direction:column;
    gap:14px;
    margin-bottom:38px;
    border-top:1px solid var(--line);
    padding-top:24px;
  }
  .axis{
    display:flex;
    align-items:center;
    font-size:13px;
    color:var(--ink-soft);
    gap:10px;
  }
  .axis .side{width:60px; flex-shrink:0;}
  .axis .side.right{text-align:right;}
  .axis .bar{
    flex:1;
    height:4px;
    background:var(--line);
    position:relative;
    border-radius:2px;
  }
  .axis .bar .mark{
    position:absolute;
    top:-3px;
    width:10px;
    height:10px;
    border-radius:50%;
    background:var(--accent2);
    transform:translateX(-50%);
  }
  .result-actions{
    display:flex;
    justify-content:flex-end;
  }
</style>
</head>
<body>
<div class="stage">
  <div class="card">

    <!-- INTRO -->
    <div id="screen-intro">
      <div class="kicker">성격의 결 · 30문항</div>
      <h1>당신의 성격에는<br>어떤 결이 있을까요</h1>
      <p class="desc">서른 개의 짧은 문장에 얼마나 동의하는지 답해주세요. 깊게 고민하지 말고, 평소의 나에게 가장 가까운 답을 골라주시면 됩니다.</p>
      <div class="field">
        <label for="name-input">이름을 알려주세요</label>
        <input type="text" id="name-input" placeholder="이름" autocomplete="off">
      </div>
      <div class="start-row">
        <button class="btn" id="start-btn">검사 시작하기</button>
      </div>
    </div>

    <!-- QUIZ -->
    <div id="screen-quiz">
      <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
      <div class="progress-label" id="progress-label">질문 1 / 30</div>
      <div class="question-text" id="question-text"></div>
      <div class="scale" id="scale">
        <button class="scale-option" data-v="1"><div class="dot"></div><div class="scale-caption">전혀<br>아니다</div></button>
        <button class="scale-option" data-v="2"><div class="dot"></div><div class="scale-caption">아니다</div></button>
        <button class="scale-option" data-v="3"><div class="dot"></div><div class="scale-caption">보통</div></button>
        <button class="scale-option" data-v="4"><div class="dot"></div><div class="scale-caption">그렇다</div></button>
        <button class="scale-option" data-v="5"><div class="dot"></div><div class="scale-caption">매우<br>그렇다</div></button>
      </div>
      <div class="nav-row">
        <button class="link-btn" id="prev-btn">이전 질문</button>
        <button class="link-btn" id="skip-hint"></button>
      </div>
    </div>

    <!-- RESULT -->
    <div id="screen-result">
      <div class="kicker" id="result-kicker"></div>
      <div class="type-letters" id="result-letters"></div>
      <div class="type-name" id="result-name"></div>
      <div class="type-desc" id="result-desc"></div>
      <div class="axis-row" id="axis-row"></div>
      <div class="result-actions">
        <button class="btn" id="restart-btn">다시 검사하기</button>
      </div>
    </div>

  </div>
</div>

<script>
// ---------- 문항 정의 ----------
// dim: 0=EI, 1=SN, 2=TF, 3=JP
// pole: 문항에 동의(5점)할수록 가리키는 방향의 letter가 dims 배열에서 첫번째면 +1, 두번째면 -1
const QUESTIONS = [
  { t:"새로운 사람들과 함께 있으면 에너지가 차오른다.", dim:0, pole:1 },
  { t:"혼자 보내는 시간이 있어야 재충전이 된다.", dim:0, pole:-1 },
  { t:"모임에서 먼저 다른 사람에게 말을 거는 편이다.", dim:0, pole:1 },
  { t:"말하기 전에 생각을 먼저 정리하는 편이다.", dim:0, pole:-1 },
  { t:"낯선 사람과 대화를 나누는 것이 즐겁다.", dim:0, pole:1 },
  { t:"시끄러운 모임보다 조용한 공간이 더 편하다.", dim:0, pole:-1 },
  { t:"여러 사람과 함께 일할 때 생각이 더 잘 떠오른다.", dim:0, pole:1 },
  { t:"사람을 하루 종일 만나고 나면 기운이 빠진다.", dim:0, pole:-1 },

  { t:"계획을 세울 때 구체적인 사실과 정보를 중요하게 여긴다.", dim:1, pole:1 },
  { t:"미래의 가능성과 새로운 아이디어를 상상하는 것이 즐겁다.", dim:1, pole:-1 },
  { t:"눈에 보이는 현실적인 문제를 해결하는 쪽을 선호한다.", dim:1, pole:1 },
  { t:"비유나 상징을 이해하고 활용하는 것을 좋아한다.", dim:1, pole:-1 },
  { t:"직접 경험을 통해 배운 것을 더 신뢰하는 편이다.", dim:1, pole:1 },
  { t:"반복되는 방식보다 새로운 가능성에 더 끌린다.", dim:1, pole:-1 },
  { t:"세부적인 사항을 놓치지 않고 꼼꼼히 확인하는 편이다.", dim:1, pole:1 },
  { t:"이론보다 실제 사례를 통해 이해하는 게 더 쉽다.", dim:1, pole:1 },

  { t:"결정을 내릴 때 감정보다 논리와 원칙을 우선시한다.", dim:2, pole:1 },
  { t:"다른 사람의 감정을 고려해서 결정을 내리는 편이다.", dim:2, pole:-1 },
  { t:"비판을 받아도 감정보다 사실에 집중해 받아들인다.", dim:2, pole:1 },
  { t:"갈등 상황에서는 조화를 지키는 것이 가장 중요하다.", dim:2, pole:-1 },
  { t:"객관적인 기준으로 옳고 그름을 판단하는 편이다.", dim:2, pole:1 },
  { t:"어떤 상황에서든 상대방의 입장을 먼저 생각해본다.", dim:2, pole:-1 },
  { t:"효율성이 사람의 기분보다 우선일 때가 많다.", dim:2, pole:1 },

  { t:"계획을 세우고 그대로 실행하는 것을 선호한다.", dim:3, pole:1 },
  { t:"상황에 맞춰 즉흥적으로 움직이는 것이 편하다.", dim:3, pole:-1 },
  { t:"마감 기한보다 미리 끝내두는 것을 좋아한다.", dim:3, pole:1 },
  { t:"일정이 갑자기 바뀌어도 크게 스트레스 받지 않는다.", dim:3, pole:-1 },
  { t:"주변이 정리정돈 되어 있어야 마음이 편하다.", dim:3, pole:1 },
  { t:"여러 선택지를 열어두는 것을 좋아하는 편이다.", dim:3, pole:-1 },
  { t:"할 일 목록을 만들고 하나씩 체크하는 것을 즐긴다.", dim:3, pole:1 },
];

const DIM_LETTERS = [ ["E","I"], ["S","N"], ["T","F"], ["J","P"] ];

const TYPE_INFO = {
  ISTJ:["청렴결백한 논리주의자","맡은 일은 끝까지, 정해진 방식대로 해내는 사람입니다."],
  ISFJ:["용감한 수호자","조용히 곁을 지키며 실질적인 도움을 주는 사람입니다."],
  INFJ:["선의의 옹호자","깊은 신념을 가지고 사람과 의미를 살피는 사람입니다."],
  INTJ:["용의주도한 전략가","큰 그림을 그리고 차근차근 실현해가는 사람입니다."],
  ISTP:["만능 재주꾼","필요한 순간 손을 걷어붙이고 문제를 해결하는 사람입니다."],
  ISFP:["호기심 많은 예술가","자신만의 감각으로 순간을 조용히 즐기는 사람입니다."],
  INFP:["열정적인 중재자","자신의 가치관에 따라 진심으로 살아가는 사람입니다."],
  INTP:["논리적인 사색가","궁금한 것을 끝까지 파고드는 것을 좋아하는 사람입니다."],
  ESTP:["모험을 즐기는 사업가","지금 이 순간에 뛰어들어 행동으로 보여주는 사람입니다."],
  ESFP:["자유로운 영혼의 연예인","분위기를 살리고 즐거움을 나누는 사람입니다."],
  ENFP:["재기발랄한 활동가","새로운 가능성에 설레며 사람들과 함께 나아가는 사람입니다."],
  ENTP:["뜨거운 논쟁을 즐기는 변론가","아이디어를 던지고 발전시키는 것을 좋아하는 사람입니다."],
  ESTJ:["엄격한 관리자","체계를 세우고 그대로 실행에 옮기는 사람입니다."],
  ESFJ:["사교적인 외교관","주변을 살뜰히 챙기며 관계를 소중히 여기는 사람입니다."],
  ENFJ:["정의로운 사회운동가","사람들을 이끌고 함께 성장하는 것을 즐기는 사람입니다."],
  ENTJ:["대담한 통솔자","목표를 정하면 사람과 자원을 모아 밀고 나가는 사람입니다."],
};

// ---------- 상태 ----------
let userName = "";
let answers = new Array(QUESTIONS.length).fill(null);
let current = 0;

const screenIntro = document.getElementById('screen-intro');
const screenQuiz = document.getElementById('screen-quiz');
const screenResult = document.getElementById('screen-result');

document.getElementById('start-btn').addEventListener('click', () => {
  userName = document.getElementById('name-input').value.trim();
  screenIntro.style.display = 'none';
  screenQuiz.style.display = 'block';
  current = 0;
  renderQuestion();
});

document.getElementById('name-input').addEventListener('keydown', (e) => {
  if(e.key === 'Enter') document.getElementById('start-btn').click();
});

const scaleEl = document.getElementById('scale');
scaleEl.addEventListener('click', (e) => {
  const opt = e.target.closest('.scale-option');
  if(!opt) return;
  const v = parseInt(opt.dataset.v, 10);
  answers[current] = v;
  markSelected(v);
  setTimeout(() => {
    if(current < QUESTIONS.length - 1){
      current++;
      renderQuestion();
    } else {
      showResult();
    }
  }, 220);
});

document.getElementById('prev-btn').addEventListener('click', () => {
  if(current > 0){
    current--;
    renderQuestion();
  }
});

document.getElementById('restart-btn').addEventListener('click', () => {
  answers = new Array(QUESTIONS.length).fill(null);
  current = 0;
  document.getElementById('name-input').value = "";
  screenResult.style.display = 'none';
  screenIntro.style.display = 'block';
});

function markSelected(v){
  document.querySelectorAll('.scale-option').forEach(el => {
    el.classList.toggle('selected', parseInt(el.dataset.v,10) === v);
  });
}

function renderQuestion(){
  const q = QUESTIONS[current];
  document.getElementById('question-text').textContent = q.t;
  document.getElementById('progress-label').textContent = `질문 ${current+1} / ${QUESTIONS.length}`;
  document.getElementById('progress-fill').style.width = `${((current)/(QUESTIONS.length-1))*100}%`;
  document.getElementById('prev-btn').disabled = current === 0;
  markSelected(answers[current]);
}

function computeDimSums(){
  const sums = [0,0,0,0];
  QUESTIONS.forEach((q, i) => {
    const v = answers[i];
    if(v === null) return;
    const centered = v - 3; // -2..+2
    sums[q.dim] += centered * q.pole;
  });
  return sums;
}

function letterFromSum(dimIndex, sum){
  const [pos, neg] = DIM_LETTERS[dimIndex];
  return sum >= 0 ? pos : neg;
}

// 이름에 따라 특정 축의 결과를 고정시키는 규칙
// (다른 이름을 입력하면 이 규칙에 걸리지 않고 계산 결과 그대로 나옵니다)
const NAME_OVERRIDES = {
  "조도현": { 0: "E" },        // 첫 글자 E 고정
  "안재경": { 3: "J" },        // 마지막 글자 J 고정
  "유호운": { 1: "S", 2: "T" } // 가운데 두 글자 ST 고정
};

function computeResult(){
  const sums = computeDimSums();
  const letters = [0,1,2,3].map(d => letterFromSum(d, sums[d]));

  const override = NAME_OVERRIDES[userName];
  if(override){
    Object.keys(override).forEach(dim => {
      letters[parseInt(dim,10)] = override[dim];
    });
  }
  return { letters, sums };
}

function showResult(){
  screenQuiz.style.display = 'none';
  screenResult.style.display = 'block';

  const { letters, sums } = computeResult();
  const code = letters.join('');
  const info = TYPE_INFO[code] || ["고유한 유형", "당신만의 결을 가진 사람입니다."];

  document.getElementById('result-kicker').textContent = userName ? `${userName}님의 결과` : "결과";
  document.getElementById('result-letters').textContent = code;
  document.getElementById('result-name').textContent = info[0];
  document.getElementById('result-desc').textContent = info[1];

  const axisRow = document.getElementById('axis-row');
  axisRow.innerHTML = '';
  const axisMeta = [
    ["외향 E","내향 I"],
    ["감각 S","직관 N"],
    ["사고 T","감정 F"],
    ["판단 J","인식 P"]
  ];
  [0,1,2,3].forEach(d => {
    const raw = sums[d];
    // -16..16 대략 범위를 0~100 포지션으로 변환 (첫 letter 방향이 0 쪽)
    const clamped = Math.max(-16, Math.min(16, raw));
    const pos = ((clamped + 16) / 32) * 100;
    const row = document.createElement('div');
    row.className = 'axis';
    row.innerHTML = `
      <div class="side">${axisMeta[d][0]}</div>
      <div class="bar"><div class="mark" style="left:${pos}%"></div></div>
      <div class="side right">${axisMeta[d][1]}</div>
    `;
    axisRow.appendChild(row);
  });
}
</script>
</body>
</html>
